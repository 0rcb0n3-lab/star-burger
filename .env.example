# Скопируй файл как .env и заполни значения.
# .env находится в .gitignore и не должен попадать в репозиторий.

# Обязательный. Сгенерировать новый:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Ключ Яндекс.Геокодера для построения расстояний на /manager/orders/.
# Получить: https://yandex.ru/dev/yandex-apps-launch/maps/console/
# Без него страница работает, но во всех строках будет «не удалось определить расстояние».
YANDEX_GEOCODER_API_KEY=

# Необязательные, значения ниже — умолчания из settings.py.

# DEBUG=True
# ALLOWED_HOSTS=127.0.0.1,localhost
# Сколько секурок запись в БД (geocoding.Place) считается свежей.
# По истечении адрес запрашивается у Яндекса заново. 86400 = сутки.
# GEOCODER_CACHE_TIMEOUT=86400
