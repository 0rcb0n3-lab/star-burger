# Скопируй файл как .env и заполни значения.
# .env находится в .gitignore и не должен попадать в репозиторий.

# Обязательный. Сгенерировать новый:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Ключ Яндекс.Геокодера: координаты адресов и расстояния до ресторанов
# на странице /manager/orders/.
# Получить: https://yandex.ru/dev/yandex-apps-launch/maps/console/
# Без него сайт работает, но координаты не определятся: у заказов будет
# «Адрес не найден», а список ресторанов с расстояниями показан не будет.
YANDEX_GEOCODER_API_KEY=

# Необязательные, значения ниже — умолчания из settings.py.

# Локальная разработка: подробные страницы ошибок и панель debug_toolbar
# (тулбар подключается в settings.py только при DEBUG=True).
# DEBUG=True
# ALLOWED_HOSTS=127.0.0.1,localhost
# С каких адресов показывать debug_toolbar.
# INTERNAL_IPS=127.0.0.1
# Сколько секунд запись в БД (geocoding.Place) считается свежей.
# По истечении адрес запрашивается у Яндекса заново. 86400 = сутки.
# GEOCODER_PLACE_TTL=86400

